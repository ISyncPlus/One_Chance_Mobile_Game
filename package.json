{
  "name": "one-chance-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.game.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run check:architecture && npm test",
    "doctor": "expo-doctor",
    "check:dependencies": "expo install --check",
    "check:architecture": "node scripts/architecture.mjs"
  },
  "dependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "expo": "57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "1.20.4",
    "typescript": "~6.0.3"
  },
  "type": "module",
  "allowScripts": {
    "@shopify/react-native-skia@2.6.2": true,
    "unrs-resolver@1.12.2": true
  }
}
